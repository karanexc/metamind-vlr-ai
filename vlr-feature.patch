+def _wl_from_record(record) -> tuple[int, int]:
+    """Parse a vlr record string like '70–44' into (wins, losses)."""
+    import re
+    if not record:
+        return 0, 0
+    nums = re.findall(r"\d+", str(record))
+    wins = int(nums[0]) if len(nums) >= 1 else 0
+    losses = int(nums[1]) if len(nums) >= 2 else 0
+    return wins, losses
