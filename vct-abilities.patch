+'use client';
+
+import { useEffect, useMemo, useState } from 'react';
+import { motion } from 'framer-motion';
+import { Search, Zap, Activity } from 'lucide-react';
+import {
+  api,
+  type AbilitySummary,
+  type AbilityAgent,
+  type AbilityPlayer,
+} from '@/lib/api';
+import { Skeleton } from '@/components/ui/skeleton';
+import { cn } from '@/lib/utils';
+
+const ROLE_COLOR: Record<string, string> = {
+  Duelist: 'text-rose-400 border-rose-400/30 bg-rose-400/10',
+  Initiator: 'text-amber-400 border-amber-400/30 bg-amber-400/10',
+  Controller: 'text-violet-400 border-violet-400/30 bg-violet-400/10',
+  Sentinel: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10',
+};
+
+function RoleChip({ role }: { role: string | null }) {
+  if (!role) return <span className="text-ink-dim">—</span>;
+  return (
+    <span
+      className={cn(
+        'inline-flex px-2 py-0.5 rounded-md text-[0.7rem] font-medium border',
+        ROLE_COLOR[role] ?? 'text-ink-soft border-border bg-surface',
+      )}
+    >
+      {role}
+    </span>
+  );
+}
+
+type Tab = 'agents' | 'players';
+
+export default function AbilitiesPage() {
+  const [summary, setSummary] = useState<AbilitySummary | null>(null);
+  const [agents, setAgents] = useState<AbilityAgent[]>([]);
+  const [players, setPlayers] = useState<AbilityPlayer[]>([]);
+  const [tab, setTab] = useState<Tab>('agents');
+  const [search, setSearch] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [failed, setFailed] = useState(false);
+
+  useEffect(() => {
+    Promise.all([
+      api.abilitiesSummary().catch(() => null),
+      api.abilitiesAgents(5).catch(() => [] as AbilityAgent[]),
+    ])
+      .then(([s, a]) => {
+        setSummary(s);
+        setAgents(a);
+        if (!s) setFailed(true);
+      })
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => {
+    if (tab !== 'players') return;
+    api.abilitiesPlayers(search, 60).then(setPlayers).catch(() => setPlayers([]));
+  }, [tab, search]);
+
+  const hasData = !!summary && summary.games > 0;
+  const yearLabel = useMemo(() => {
+    if (!summary?.year_min) return '';
+    return summary.year_min === summary.year_max
+      ? `${summary.year_min}`
+      : `${summary.year_min}–${summary.year_max}`;
+  }, [summary]);
+
+  return (
+    <div className="max-w-7xl mx-auto px-6 lg:px-8 py-16">
+      {/* Hero */}
+      <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}>
+        <div className="flex items-center gap-2 text-[0.7rem] font-medium uppercase tracking-widest text-ink-dim mb-3">
+          <Zap className="w-3.5 h-3.5 text-accent" />
+          Ability analysis · VCT esports telemetry
+        </div>
+        <h1 className="text-display font-semibold tracking-tight text-gradient">
+          What the utility actually did.
+        </h1>
+        <p className="mt-4 text-base text-ink-soft max-w-2xl">
+          Measured ability and ultimate usage from real VCT matches
+          {yearLabel && ` (${yearLabel})`} — Riot game telemetry, not inferred
+          from agent picks. This is a historical corpus, separate from the live
+          vlr data.
+        </p>
+      </motion.div>
+
+      {/* Coverage tiles */}
+      <motion.div
+        initial={{ opacity: 0 }}
+        animate={{ opacity: 1 }}
+        transition={{ delay: 0.12 }}
+        className="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3"
+      >
+        {[
+          { label: 'Games', value: summary?.games },
+          { label: 'Players', value: summary?.players },
+          { label: 'Agents', value: summary?.agents },
+          { label: 'Seasons', value: yearLabel || '—' },
+        ].map((t) => (
+          <div key={t.label} className="bg-surface border border-border rounded-2xl p-4">
+            <div className="text-[0.65rem] uppercase tracking-widest text-ink-dim mb-1">
+              {t.label}
+            </div>
+            <div className="font-mono text-2xl font-semibold text-ink tabular">
+              {loading ? '…' : (t.value ?? 0)}
+            </div>
+          </div>
+        ))}
+      </motion.div>
+
+      {/* Empty / offline state */}
+      {!loading && !hasData && (
+        <div className="mt-8 bg-surface border border-border rounded-2xl p-8 text-center">
+          <Activity className="w-6 h-6 text-ink-dim mx-auto mb-3" />
+          <div className="text-ink font-medium mb-1">
+            {failed ? 'Ability data unavailable' : 'No VCT ability data imported yet'}
+          </div>
+          <p className="text-sm text-ink-soft max-w-md mx-auto">
+            Populate it once from Riot&apos;s public VCT dataset:
+          </p>
+          <code className="mt-3 inline-block bg-bg border border-border rounded-lg px-3 py-2 text-xs text-ink-soft font-mono">
+            python -m src.vlr.cli import-vct-abilities --tier vct-international --year 2024
+          </code>
+        </div>
+      )}
+
+      {hasData && (
+        <>
+          {/* Tabs + search */}
+          <motion.div
+            initial={{ opacity: 0 }}
+            animate={{ opacity: 1 }}
+            transition={{ delay: 0.2 }}
+            className="mt-10 flex flex-wrap items-center justify-between gap-4"
+          >
+            <div className="flex gap-1 p-1 bg-surface border border-border rounded-xl">
+              {(['agents', 'players'] as Tab[]).map((t) => (
+                <button
+                  key={t}
+                  onClick={() => setTab(t)}
+                  className={cn(
+                    'px-4 py-1.5 text-sm font-medium rounded-lg transition-all capitalize',
+                    tab === t
+                      ? 'bg-accent text-white shadow-lg shadow-accent/20'
+                      : 'text-ink-soft hover:text-ink hover:bg-surface-hover',
+                  )}
+                >
+                  {t === 'agents' ? 'By Agent' : 'Players'}
+                </button>
+              ))}
+            </div>
+            {tab === 'players' && (
+              <div className="relative">
+                <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-dim" />
+                <input
+                  value={search}
+                  onChange={(e) => setSearch(e.target.value)}
+                  placeholder="Search players…"
+                  className="pl-9 pr-4 py-2 bg-surface border border-border rounded-lg text-sm text-ink placeholder:text-ink-dim focus:outline-none focus:border-border-strong w-64"
+                />
+              </div>
+            )}
+          </motion.div>
+
+          {/* Table */}
+          <motion.div
+            initial={{ opacity: 0, y: 16 }}
+            animate={{ opacity: 1, y: 0 }}
+            transition={{ delay: 0.28 }}
+            className="mt-6 bg-surface border border-border rounded-2xl overflow-x-auto"
+          >
+            {tab === 'agents' ? (
+              <table className="w-full min-w-[720px] text-sm">
+                <thead>
+                  <tr className="border-b border-border text-[0.65rem] uppercase tracking-widest text-ink-dim">
+                    <th className="text-left font-medium px-5 py-3">Agent</th>
+                    <th className="text-left font-medium px-5 py-3">Role</th>
+                    <th className="text-right font-medium px-5 py-3">Games</th>
+                    <th className="text-right font-medium px-5 py-3">Utility / round</th>
+                    <th className="text-right font-medium px-5 py-3">Ults / game</th>
+                    <th className="text-right font-medium px-5 py-3">K/D</th>
+                    <th className="text-right font-medium px-5 py-3">Win %</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {agents.map((a) => (
+                    <tr key={a.agent} className="border-b border-border last:border-0 hover:bg-bg/20">
+                      <td className="px-5 py-3 font-semibold text-ink">{a.agent}</td>
+                      <td className="px-5 py-3"><RoleChip role={a.role} /></td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{a.games}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink">
+                        <span className="text-accent font-semibold">{a.ability_casts_per_round}</span>
+                      </td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{a.ults_per_game}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{a.kd}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{a.win_rate}%</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            ) : (
+              <table className="w-full min-w-[680px] text-sm">
+                <thead>
+                  <tr className="border-b border-border text-[0.65rem] uppercase tracking-widest text-ink-dim">
+                    <th className="text-left font-medium px-5 py-3">Player</th>
+                    <th className="text-left font-medium px-5 py-3">Team</th>
+                    <th className="text-right font-medium px-5 py-3">Games</th>
+                    <th className="text-right font-medium px-5 py-3">Utility / round</th>
+                    <th className="text-right font-medium px-5 py-3">Ults / game</th>
+                    <th className="text-right font-medium px-5 py-3">K/D</th>
+                    <th className="text-right font-medium px-5 py-3">Win %</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {players.length === 0 && (
+                    <tr>
+                      <td colSpan={7} className="px-5 py-10 text-center text-ink-dim">
+                        No players match.
+                      </td>
+                    </tr>
+                  )}
+                  {players.map((p) => (
+                    <tr key={p.player_name} className="border-b border-border last:border-0 hover:bg-bg/20">
+                      <td className="px-5 py-3 font-semibold text-ink">{p.player_name}</td>
+                      <td className="px-5 py-3 text-ink-dim">{p.team_tag ?? '—'}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{p.games}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-accent font-semibold">
+                        {p.ability_casts_per_round}
+                      </td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{p.ults_per_game}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{p.kd}</td>
+                      <td className="px-5 py-3 text-right font-mono tabular text-ink-soft">{p.win_rate}%</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            )}
+          </motion.div>
+        </>
+      )}
+
+      {/* Methodology footnote */}
+      <div className="mt-6 text-xs text-ink-dim max-w-3xl leading-relaxed">
+        <span className="font-medium text-ink-soft">Methodology:</span> ability
+        usage is derived from Riot&apos;s per-tick state telemetry — a cast is
+        counted when a player&apos;s ability charge drops within a round;
+        ultimates are counted when a ready ult is spent. &quot;Utility / round&quot;
+        combines the two non-grenade ability slots. Agents resolve via
+        valorant-api. Data: Riot VCT esports dataset (2022–2024), historical.
+      </div>
+    </div>
+  );
+}
