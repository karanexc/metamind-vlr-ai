new file mode 100644
index 0000000..aa4b965
--- /dev/null
+++ b/src/vlr/vct/parse.py
@@ -0,0 +1,191 @@
+"""Parse one VCT game (an event stream) into per-player ability/ult usage.
+
+The game files are a time-ordered list of events; each event is a dict with
+`platformGameId`, `metadata`, and exactly one type body (`configuration`,
+`snapshot`, `playerDied`, `roundStarted`, `roundDecided`, ...).
+
+Ability usage is DERIVED from state snapshots: every snapshot carries each
+player's current charges per slot (GRENADE / ABILITY_1 / ABILITY_2 / ULTIMATE).
+When a slot's charge drops within a round, the player cast that ability. Ult
+points accumulate across rounds and only fall when the ultimate is fired, so
+ult casts are counted cleanly (ready -> spent). This is a state-diff proxy, not
+a discrete cast log — see the module docstring / methodology note in the UI.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional
+
+_ABILITY_SLOTS = ("ABILITY_1", "ABILITY_2", "GRENADE")
+_ULT_SLOT = "ULTIMATE"
+
+
+@dataclass
+class PlayerAbilities:
+    player_id: int
+    handle: str = ""
+    agent: Optional[str] = None
+    role: Optional[str] = None
+    team_id: Optional[int] = None
+    team_name: str = ""
+    ability1_casts: int = 0
+    ability2_casts: int = 0
+    grenade_casts: int = 0
+    ult_casts: int = 0
+    kills: int = 0
+    deaths: int = 0
+    won: bool = False
+
+
+@dataclass
+class GameResult:
+    game_id: str
+    map_name: Optional[str]
+    date: Optional[str]
+    total_rounds: int
+    winner_team_id: Optional[int]
+    round_wins: dict            # team_id -> rounds won
+    team_names: dict            # team_id -> name
+    players: list               # list[PlayerAbilities]
+
+
+def _cur(ability: dict) -> int:
+    return (ability.get("baseCharges", 0) or 0) + (ability.get("temporaryCharges", 0) or 0)
+
+
+def _slot(ability: dict) -> Optional[str]:
+    fb = (ability.get("ability", {}) or {}).get("fallback", {}) or {}
+    return (fb.get("inventorySlot", {}) or {}).get("slot")
+
+
+def parse_game(events: list, agent_map: Optional[dict] = None,
+               map_map: Optional[dict] = None) -> Optional[GameResult]:
+    """Return a GameResult, or None if the stream has no usable configuration.
+
+    agent_map: {AGENT_GUID_UPPER: (name, role)}   (from valorant-api)
+    map_map:   {map_asset_path: display_name}       (from valorant-api)
+    """
+    agent_map = agent_map or {}
+    map_map = map_map or {}
+
+    game_id: Optional[str] = None
+    map_name: Optional[str] = None
+    date: Optional[str] = None
+    team_names: dict = {}
+    player_team: dict = {}
+    players: dict[int, PlayerAbilities] = {}
+
+    last_charge: dict = {}      # (player_id, slot) -> last current charge
+    ult_cost: dict = {}         # player_id -> ult max charges (points to fire)
+    round_active = False
+    total_rounds = 0
+    round_wins: dict = {}
+
+    for e in events:
+        if game_id is None and e.get("platformGameId"):
+            game_id = e["platformGameId"]
+        md = e.get("metadata")
+        if md and date is None and md.get("wallTime"):
+            date = md["wallTime"]
+
+        if "configuration" in e:
+            c = e["configuration"]
+            sm = (c.get("selectedMap", {}) or {}).get("fallback", {}) or {}
+            asset = sm.get("guid") or ""
+            map_name = map_map.get(asset) or sm.get("displayName") or map_name
+            for t in c.get("teams", []):
+                tid = (t.get("teamId", {}) or {}).get("value")
+                if tid is not None:
+                    team_names[tid] = t.get("name", team_names.get(tid, ""))
+                    for pv in t.get("playersInTeam", []):
+                        player_team[pv.get("value")] = tid
+            for p in c.get("players", []):
+                pid = (p.get("playerId", {}) or {}).get("value")
+                if pid is None:
+                    continue
+                pa = players.setdefault(pid, PlayerAbilities(player_id=pid))
+                pa.handle = p.get("displayName") or pa.handle
+                sa = (p.get("selectedAgent", {}) or {}).get("fallback", {}) or {}
+                resolved = agent_map.get((sa.get("guid") or "").upper())
+                if resolved:
+                    pa.agent, pa.role = resolved
+            continue
+
+        if "roundStarted" in e:
+            round_active = True
+            total_rounds = max(total_rounds, e["roundStarted"].get("roundNumber", total_rounds))
+            for key in list(last_charge):
+                if key[1] in _ABILITY_SLOTS:   # ult carries across rounds; re-baseline the rest
+                    last_charge[key] = None
+            continue
+
+        if "roundDecided" in e:
+            round_active = False
+            wt = ((e["roundDecided"].get("result", {}) or {}).get("winningTeam", {}) or {}).get("value")
+            if wt is not None:
+                round_wins[wt] = round_wins.get(wt, 0) + 1
+            continue
+
+        if "playerDied" in e:
+            pd = e["playerDied"]
+            dec = (pd.get("deceasedId", {}) or {}).get("value")
+            kil = (pd.get("killerId", {}) or {}).get("value")
+            if dec in players:
+                players[dec].deaths += 1
+            if kil is not None and kil in players and kil != dec:
+                players[kil].kills += 1
+            continue
+
+        if "snapshot" in e:
+            for p in e["snapshot"].get("players", []):
+                pid = (p.get("playerId", {}) or {}).get("value")
+                if pid is None:
+                    continue
+                pa = players.setdefault(pid, PlayerAbilities(player_id=pid))
+                for ab in p.get("abilities", []):
+                    slot = _slot(ab)
+                    if slot not in _ABILITY_SLOTS and slot != _ULT_SLOT:
+                        continue
+                    cur = _cur(ab)
+                    key = (pid, slot)
+                    prev = last_charge.get(key)
+                    if slot == _ULT_SLOT:
+                        mx = ab.get("maxCharges", 0) or 0
+                        if mx:
+                            ult_cost[pid] = mx
+                        if prev is not None and cur < prev:
+                            cost = ult_cost.get(pid, 0)
+                            if cost and prev >= cost:      # was ready -> fired
+                                pa.ult_casts += 1
+                        last_charge[key] = cur
+                    else:
+                        if prev is not None and round_active and cur < prev:
+                            amt = prev - cur
+                            if slot == "ABILITY_1":
+                                pa.ability1_casts += amt
+                            elif slot == "ABILITY_2":
+                                pa.ability2_casts += amt
+                            else:
+                                pa.grenade_casts += amt
+                        last_charge[key] = cur
+            continue
+
+    if not players:
+        return None
+
+    winner = max(round_wins, key=round_wins.get) if round_wins else None
+    for pa in players.values():
+        pa.team_id = player_team.get(pa.player_id)
+        pa.team_name = team_names.get(pa.team_id, "")
+        pa.won = winner is not None and pa.team_id == winner
+
+    return GameResult(
+        game_id=game_id or "",
+        map_name=map_name,
+        date=date,
+        total_rounds=total_rounds,
+        winner_team_id=winner,
+        round_wins=round_wins,
+        team_names=team_names,
+        players=list(players.values()),
+    )
